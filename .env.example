# ---- Core ----
NODE_ENV=development

# ---- Server ----
PORT=4000
# Full URL the client will use to hit the API (used for CORS + OAuth callbacks)
SERVER_URL=http://localhost:4000
# Full URL of the client (used for CORS + auth redirects)
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Example (local): postgres://postgres:postgres@localhost:5432/network_map
# Example (Neon):  postgres://user:pw@ep-xxx.us-east-1.aws.neon.tech/network_map?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/network_map

# ---- Auth ----
# Generate with:  openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-long-random-string
# Google OAuth (https://console.cloud.google.com → OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI providers (server-side only; NEVER expose to client) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# ---- Stripe (optional — billing is stubbed without these) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One price ID per credit pack (see server/src/billing/packs.ts)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ---- Apollo (stub for now) ----
APOLLO_API_KEY=

# ---- Client (Vite only reads VITE_* vars) ----
VITE_API_URL=http://localhost:4000
# Dev-only: skip real auth and use the in-memory mock API. NEVER set to 1 in prod.
VITE_MOCK_AUTH=0
VITE_SKIP_AUTH=0
